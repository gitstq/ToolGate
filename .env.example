# ============================================================
# ToolGate example configuration.
# Copy to ".env" and adjust, or export the variables in your shell.
# Real environment variables always override values from this file.
# ============================================================

# State directory (database, master key, audit log)
TOOLGATE_HOME=/var/lib/toolgate

# Network interface / port for the gateway
TOOLGATE_HOST=0.0.0.0
TOOLGATE_PORT=8848

# Master encryption key for credentials at rest.
# Generate one with:  toolgate keygen
# If left empty, ToolGate creates "master.key" inside TOOLGATE_HOME (0600).
TOOLGATE_MASTER_KEY=

# Default per-token rate limit (requests per minute); 0 disables limiting
TOOLGATE_RATE_LIMIT=600

# Timeouts (seconds)
TOOLGATE_UPSTREAM_TIMEOUT=60
TOOLGATE_CLI_TIMEOUT=60

# Max bytes captured from a CLI tool's stdout / stderr
TOOLGATE_CLI_OUTPUT_CAP=1048576
